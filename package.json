{
  "name": "@efrembaraldo/gsd-pi-hermes-memory",
  "version": "0.0.7",
  "description": "🧠 Persistent memory + 🔍 session search + 🛡️ secret scanning for GSD Pi. Token-aware policy-only memory by default, SQLite FTS5 search, auto-consolidation, procedural skills. 732 tests. Ported from Hermes agent. Fork of chandra447/pi-hermes-memory",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "precheck": "node scripts/link-pi-sdks.mjs",
    "check": "node scripts/ensure-dev.mjs check && tsc --noEmit",
    "check:min-sdk": "node scripts/ensure-dev.mjs check && node scripts/check-min-sdk.mjs",
    "pretest": "node scripts/link-pi-sdks.mjs",
    "test": "node scripts/ensure-dev.mjs test && tests/run-all.sh",
    "setup:types": "node scripts/setup-types.mjs",
    "prepublishOnly": "node scripts/link-pi-sdks.mjs && npm run check && npm test"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory",
    "persistent-memory",
    "session-search",
    "sqlite",
    "fts5",
    "skills",
    "learning-loop",
    "agent",
    "hermes",
    "secret-scanning",
    "content-scanner",
    "correction-detection",
    "auto-consolidation",
    "memory-aging",
    "context-fencing",
    "two-tier-memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/efrembaraldo/gsd-pi-hermes-memory"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@opengsd/gsd-pi": "^1.17.0",
    "better-sqlite3": "^13.0.3",
    "strip-ansi": "7.2.0",
    "typebox": "^1.1.33"
  }
}
